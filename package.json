{
    "name": "monosandbox_server",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev -p 3002",
        "dev:vm": "docker compose up vm-orchestrator",
        "setup-container": "bun scripts/setup-container.js",
        "start-container": "docker compose -f docker-compose.prod.yml up -d",
        "docker-shell": "docker compose exec vm-orchestrator bash",
        "reload-vsock": "docker compose exec vm-orchestrator bash /app/setup-vsock-binaries.sh && docker compose restart vm-orchestrator",
        "reload-fileserver": "docker compose exec vm-orchestrator bash /app/setup-fileserver-js.sh && docker compose restart vm-orchestrator",
        "reload-container": "docker compose restart vm-orchestrator",
        "setup-vnc": "docker compose exec vm-orchestrator bash /app/setup-vnc.sh",
        "clear-rootfs": "docker compose exec vm-orchestrator rm -f /opt/firecracker/rootfs/ubuntu.ext4 /opt/firecracker/rootfs/initramfs.img",
        "clear-uv-nvm-cache": "docker compose run --rm --no-deps --entrypoint sh vm-orchestrator -lc \"rm -rf /opt/firecracker/cache/uv /opt/firecracker/cache/uv-install.sh /opt/firecracker/cache/uv-install.sh.sha256 /opt/firecracker/cache/nvm-install.sh /opt/firecracker/cache/nvm-install.sh.sha256\"",
        "build": "next build",
        "start": "next start -p 3002",
        "lint": "eslint"
    },
    "dependencies": {
        "@hookform/resolvers": "^5.2.2",
        "@monaco-editor/react": "^4.7.0",
        "@paralleldrive/cuid2": "^3.3.0",
        "@radix-ui/react-accordion": "^1.2.12",
        "@radix-ui/react-alert-dialog": "^1.1.15",
        "@radix-ui/react-context-menu": "^2.2.16",
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-dropdown-menu": "^2.1.16",
        "@radix-ui/react-label": "^2.1.8",
        "@radix-ui/react-scroll-area": "^1.2.10",
        "@radix-ui/react-select": "^2.2.6",
        "@radix-ui/react-separator": "^1.1.8",
        "@radix-ui/react-slot": "^1.2.4",
        "@radix-ui/react-switch": "^1.2.6",
        "@types/better-sqlite3": "^7.6.13",
        "@xterm/addon-fit": "^0.11.0",
        "@xterm/xterm": "^6.0.0",
        "better-sqlite3": "^12.6.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "dotenv": "^17.2.3",
        "file-icons-js": "^1.1.0",
        "lucide-react": "0.562.0",
        "monaco-editor": "^0.55.1",
        "next": "^16.1.6",
        "next-themes": "^0.4.6",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-hook-form": "^7.71.1",
        "server-only": "^0.0.1",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.4.0",
        "tinykeys": "^3.0.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.1.18",
        "@types/bun": "^1.3.7",
        "@types/node": "^25.1.0",
        "@types/react": "^19.2.10",
        "@types/react-dom": "^19.2.3",
        "eslint": "^9.39.2",
        "eslint-config-next": "^16.1.6",
        "tailwindcss": "^4.1.18",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.9.3"
    },
    "prettier": {
        "trailingComma": "none",
        "tabWidth": 4,
        "semi": false,
        "singleQuote": false
    }
}
